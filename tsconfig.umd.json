{
    // Second compilation of the very same `src/core` sources, this time as a
    // single AMD file. `tsc` is what resolves and orders the module graph; the
    // result is spliced into the UMD envelope by scripts/build-umd.ts.
    "extends": "./tsconfig.json",
    "compilerOptions": {
        // `outFile` only works with AMD (or System), and AMD is the format
        // whose `define` calls a 20-line runtime can serve. Bare specifiers —
        // here only "fflate" — are left unresolved for that runtime to supply.
        "module": "amd",
        "outFile": "dist/umd/xlsx-now.amd.js",
        // NodeNext resolution requires a NodeNext module target. "node" still
        // maps the "./x.js" specifiers back to "./x.ts", so the sources are
        // read exactly as the main build reads them.
        "moduleResolution": "node",
        // Not allowed alongside AMD, and redundant: the main build already
        // enforces it over these same files.
        "verbatimModuleSyntax": false,
        // Types (and their maps) come from the main build in dist/src; the
        // "./umd" export points at those.
        "declaration": false,
        "declarationMap": false,
        // Keeps the module names in the emitted `define(...)` calls short
        // ("zip" instead of "src/core/zip").
        "rootDir": "src/core"
    },
    // Only the public core: the node/ and browser/ faces are ESM-only, and the
    // examples and scripts have no place in the bundle.
    "include": ["src/core/**/*.ts"]
}
