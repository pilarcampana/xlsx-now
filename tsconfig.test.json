// The test build: the same sources and the same settings as the shipped one,
// with the tests compiled alongside them into dist-test/.
//
// Nothing about the module format changes — the tests load the very ESM that
// `npm run build` emits into dist/, which is the point: a package whose claim
// is that its output loads unchanged in Node and in the browser should not be
// tested through a transliteration of itself.
//
// Coverage rides along on that: `c8` reads V8's own coverage, so there is
// nothing to instrument and no module format it cannot see, and the source
// maps `tsc` emits are what put the report back on the `.ts` files.
{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "outDir": "dist-test",
        "types": ["node", "mocha"],
        // Nothing consumes these types; the declarations are dead weight.
        "declaration": false,
        "declarationMap": false
    },
    "include": ["src/**/*.ts", "test/**/*.ts"]
}
